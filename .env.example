# ==============================================================================
# Doctolib Germany (doctolib.de) Slot Sniper & Monitor Configuration
# ==============================================================================

DOCTOLIB_BASE_URL=https://www.doctolib.de
DOCTOLIB_IMPERSONATE=chrome124
DOCTOLIB_REQUEST_TIMEOUT=25
DOCTOLIB_MIN_DELAY=0.45
DOCTOLIB_MAX_DELAY=1.10
DOCTOLIB_MAX_RETRIES=3

# Database & Export Paths
DOCTOLIB_DB_PATH=data/doctolib.db
DOCTOLIB_SAMPLES_DIR=data/samples

# Appointment Sniper & Dry-Run Booking Rules
SNIPER_MAX_WAIT_DAYS=7
SNIPER_ALLOW_NEW_PATIENTS_ONLY=true
SNIPER_PREFERRED_HOUR_START=8
SNIPER_PREFERRED_HOUR_END=19

# Multi-Channel Alerting & Automation Hooks (Leave empty for Safe Mock Mode)
WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
