# ==============================================================================
# 1. TELEGRAM BOT & SUBSCRIPTION POLLING (Primary User Service)
# ==============================================================================
# Paste your Telegram Bot token from @BotFather here:
TELEGRAM_BOT_TOKEN=

# How often the background worker checks Doctolib for active subscriptions (in minutes)
BOT_POLL_INTERVAL_MINUTES=10

# How many top practitioners to check per "City + Specialty" subscription
BOT_MAX_DOCTORS_PER_SEARCH=15

# Prevent duplicate alerts for the exact same slot within this time window (in hours)
BOT_ALERT_DEDUP_HOURS=24

# Maximum new slot alerts sent per subscription in a single poll cycle (prevents chat flood)
BOT_MAX_ALERTS_PER_CYCLE=3


# ==============================================================================
# 2. DEFAULT USER PREFERENCES (Used by CLI & Web Engineer Console)
# ==============================================================================
SNIPER_MAX_WAIT_DAYS=7
SNIPER_ALLOW_NEW_PATIENTS_ONLY=true
SNIPER_PREFERRED_HOUR_START=7
SNIPER_PREFERRED_HOUR_END=20


# ==============================================================================
# 3. SCRAPER ENGINE & NETWORK (Under the Hood)
# ==============================================================================
DOCTOLIB_BASE_URL=https://www.doctolib.de
DOCTOLIB_IMPERSONATE=chrome124
DOCTOLIB_REQUEST_TIMEOUT=25
DOCTOLIB_MIN_DELAY=0.40
DOCTOLIB_MAX_DELAY=0.90
DOCTOLIB_MAX_RETRIES=3


# ==============================================================================
# 4. STORAGE & OPTIONAL EXTERNAL WEBHOOKS (n8n / Slack)
# ==============================================================================
DOCTOLIB_DB_PATH=data/doctolib.db
DOCTOLIB_SAMPLES_DIR=data/samples

# Optional: forward matched slots to n8n or Slack
WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
